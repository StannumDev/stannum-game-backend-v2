{
  "name": "stannum-game-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for the STANNUM Game backend. Lets the Stannum team query the Game (users, progress, programs, stats, orders, subscriptions...) from any MCP client (Claude Code, Claude Desktop, etc).",
  "type": "module",
  "bin": {
    "stannum-game-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/httpEntry.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/httpEntry.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "axios": "^1.13.2",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0"
  }
}
